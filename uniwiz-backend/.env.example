# =============================================================================
# UniWiz Backend - Environment Configuration Template
# Copy this file to .env and fill in your values
# =============================================================================

# --- Database Configuration ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=uniwiz_db
DB_USER=root
DB_PASS=

# --- SMTP Email Configuration (PHPMailer) ---
# For Gmail, use an App Password (not your normal password)
# For SendGrid, use SMTP_USER="apikey" and SMTP_PASS="your-sendgrid-api-key"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME="UniWiz Platform"

# --- Stripe Payment Gateway ---
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key

# --- Application URLs ---
APP_URL=http://uniwiz-backend.test
FRONTEND_URL=http://localhost:3000
