# =============================================================================
# UniWiz Supabase & Prisma Environment Configuration
# =============================================================================

# 1. Connection Pooling URL (port 6543) - Recommended for application queries
# Replace [YOUR-PASSWORD] and [YOUR-PROJECT-REF] with your Supabase credentials
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# 2. Direct Connection URL (port 5432) - Required for Prisma migrations and schema push
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:5432/postgres"

# Note: You can find both URLs in your Supabase Dashboard:
# Project Settings -> Database -> Connection string -> URI / Prisma

