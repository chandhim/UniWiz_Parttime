// Prisma Schema for UniWiz - University Part-Time Job Portal
// Configured for PostgreSQL (Supabase)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum UserRole {
  STUDENT   @map("student")
  PUBLISHER @map("publisher")
  ADMIN     @map("admin")
}

enum UserStatus {
  ACTIVE   @map("active")
  BLOCKED  @map("blocked")
  INACTIVE @map("inactive")
}

enum JobStatus {
  ACTIVE   @map("active")
  DRAFT    @map("draft")
  PENDING  @map("pending")
  INACTIVE @map("inactive")
  EXPIRED  @map("expired")
}

enum JobPaymentStatus {
  PENDING @map("pending")
  PAID    @map("paid")
  FAILED  @map("failed")
}

enum ApplicationStatus {
  PENDING  @map("pending")
  VIEWED   @map("viewed")
  ACCEPTED @map("accepted")
  REJECTED @map("rejected")
}

enum ReviewStatus {
  ACTIVE  @map("active")
  HIDDEN  @map("hidden")
  FLAGGED @map("flagged")
}

enum PaymentRecordStatus {
  PENDING    @map("pending")
  PROCESSING @map("processing")
  COMPLETED  @map("completed")
  FAILED     @map("failed")
  CANCELLED  @map("cancelled")
  REFUNDED   @map("refunded")
}

enum ReportType {
  USER         @map("user")
  CONVERSATION @map("conversation")
  APP_PROBLEM  @map("app_problem")
}

enum ReportStatus {
  PENDING   @map("pending")
  RESOLVED  @map("resolved")
  DISMISSED @map("dismissed")
}

// -----------------------------------------------------------------------------
// Core User Models
// -----------------------------------------------------------------------------

model User {
  id                     Int       @id @default(autoincrement())
  email                  String    @unique @db.VarChar(255)
  password               String    @db.VarChar(255)
  firstName              String?   @map("first_name") @db.VarChar(100)
  lastName               String?   @map("last_name") @db.VarChar(100)
  companyName            String?   @map("company_name") @db.VarChar(255)
  role                   UserRole  @default(STUDENT)
  profileImageUrl        String?   @map("profile_image_url") @db.Text
  status                 UserStatus @default(ACTIVE)
  isVerified             Boolean   @default(false) @map("is_verified")
  emailVerificationToken String?   @map("email_verification_token") @db.VarChar(255)
  emailVerifiedAt        DateTime? @map("email_verified_at")
  resetToken             String?   @map("reset_token") @db.VarChar(255)
  resetTokenExpiry       DateTime? @map("reset_token_expiry")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  // Profiles
  studentProfile   StudentProfile?
  publisherProfile PublisherProfile?

  // Publisher relations
  jobs            Job[]            @relation("PublisherJobs")
  publisherImages PublisherImage[] @relation("PublisherImages")

  // Student relations
  applications JobApplication[] @relation("StudentApplications")
  wishlist     Wishlist[]       @relation("StudentWishlist")

  // Communication relations
  conversationsAsUserOne Conversation[] @relation("ConversationsAsUserOne")
  conversationsAsUserTwo Conversation[] @relation("ConversationsAsUserTwo")
  sentMessages           Message[]      @relation("SentMessages")
  receivedMessages       Message[]      @relation("ReceivedMessages")
  notifications          Notification[]

  // Reviews
  companyReviewsGiven    CompanyReview[] @relation("StudentCompanyReviews")
  companyReviewsReceived CompanyReview[] @relation("PublisherCompanyReviews")
  studentReviewsGiven    StudentReview[] @relation("PublisherStudentReviews")
  studentReviewsReceived StudentReview[] @relation("StudentReviewsReceived")
  genericReviewsGiven    Review[]        @relation("ReviewerReviews")
  genericReviewsReceived Review[]        @relation("RevieweeReviews")

  // Payments
  paymentsAsPublisher Payment[] @relation("PublisherPayments")
  paymentsAsStudent   Payment[] @relation("StudentPayments")

  // Reports
  reportsFiled    Report[] @relation("ReporterReports")
  reportsReceived Report[] @relation("ReportedUserReports")

  @@index([email])
  @@index([role])
  @@index([status])
  @@map("users")
}

model StudentProfile {
  id                  Int      @id @default(autoincrement())
  userId              Int      @unique @map("user_id")
  universityName      String?  @map("university_name") @db.VarChar(255)
  fieldOfStudy        String?  @map("field_of_study") @db.VarChar(255)
  yearOfStudy         String?  @map("year_of_study") @db.VarChar(50)
  languagesSpoken     String?  @map("languages_spoken") @db.VarChar(255)
  preferredCategories String?  @map("preferred_categories") @db.Text
  skills              String?  @db.Text
  cvUrl               String?  @map("cv_url") @db.Text
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("student_profiles")
}

model PublisherProfile {
  id             Int      @id @default(autoincrement())
  userId         Int      @unique @map("user_id")
  about          String?  @db.Text
  industry       String?  @db.VarChar(100)
  websiteUrl     String?  @map("website_url") @db.VarChar(255)
  address        String?  @db.Text
  phoneNumber    String?  @map("phone_number") @db.VarChar(50)
  facebookUrl    String?  @map("facebook_url") @db.VarChar(255)
  linkedinUrl    String?  @map("linkedin_url") @db.VarChar(255)
  instagramUrl   String?  @map("instagram_url") @db.VarChar(255)
  coverImageUrl  String?  @map("cover_image_url") @db.Text
  requiredDocUrl String?  @map("required_doc_url") @db.Text
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("publisher_profiles")
}

// -----------------------------------------------------------------------------
// Job Models
// -----------------------------------------------------------------------------

model JobCategory {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(100)
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  jobs Job[]

  @@map("job_categories")
}

model Job {
  id                  Int              @id @default(autoincrement())
  publisherId         Int              @map("publisher_id")
  categoryId          Int?             @map("category_id")
  title               String           @db.VarChar(255)
  description         String           @db.Text
  skillsRequired      String?          @map("skills_required") @db.Text
  jobType             String           @map("job_type") @db.VarChar(50)
  paymentRange        String?          @map("payment_range") @db.VarChar(100)
  location            String?          @db.VarChar(255)
  requirements        String?          @db.Text
  benefits            String?          @db.Text
  workMode            String?          @default("on-site") @map("work_mode") @db.VarChar(50)
  startDate           DateTime?        @map("start_date")
  endDate             DateTime?        @map("end_date")
  deadline            DateTime?        @map("deadline")
  applicationDeadline DateTime?        @map("application_deadline")
  vacancies           Int              @default(1)
  workingHours        String?          @map("working_hours") @db.VarChar(100)
  experienceLevel     String?          @default("any") @map("experience_level") @db.VarChar(50)
  status              JobStatus        @default(ACTIVE)
  paymentStatus       JobPaymentStatus @default(PENDING) @map("payment_status")
  paymentAmount       Decimal?         @map("payment_amount") @db.Decimal(10, 2)
  paymentMethod       String?          @map("payment_method") @db.VarChar(50)
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  // Relations
  publisher      User             @relation("PublisherJobs", fields: [publisherId], references: [id], onDelete: Cascade)
  category       JobCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  applications   JobApplication[]
  wishlists      Wishlist[]
  conversations  Conversation[]
  payments       Payment[]
  companyReviews CompanyReview[]
  studentReviews StudentReview[]

  @@index([publisherId])
  @@index([categoryId])
  @@index([status])
  @@index([createdAt])
  @@map("jobs")
}

model JobApplication {
  id        Int               @id @default(autoincrement())
  jobId     Int               @map("job_id")
  studentId Int               @map("student_id")
  proposal  String?           @db.Text
  status    ApplicationStatus @default(PENDING)
  appliedAt DateTime          @default(now()) @map("applied_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  job     Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  student User @relation("StudentApplications", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([jobId, studentId], name: "unique_job_student_application")
  @@index([studentId])
  @@index([jobId])
  @@index([status])
  @@map("job_applications")
}

// -----------------------------------------------------------------------------
// Messaging & Communication Models
// -----------------------------------------------------------------------------

model Conversation {
  id        Int      @id @default(autoincrement())
  userOneId Int      @map("user_one_id")
  userTwoId Int      @map("user_two_id")
  jobId     Int?     @map("job_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  userOne  User      @relation("ConversationsAsUserOne", fields: [userOneId], references: [id], onDelete: Cascade)
  userTwo  User      @relation("ConversationsAsUserTwo", fields: [userTwoId], references: [id], onDelete: Cascade)
  job      Job?      @relation(fields: [jobId], references: [id], onDelete: SetNull)
  messages Message[]
  reports  Report[]

  @@index([userOneId, userTwoId])
  @@map("conversations")
}

model Message {
  id             Int          @id @default(autoincrement())
  conversationId Int          @map("conversation_id")
  senderId       Int          @map("sender_id")
  receiverId     Int          @map("receiver_id")
  messageText    String       @map("message_text") @db.Text
  isRead         Boolean      @default(false) @map("is_read")
  createdAt      DateTime     @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver     User         @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([receiverId, isRead])
  @@map("messages")
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  type      String   @db.VarChar(50)
  message   String   @db.Text
  link      String?  @db.VarChar(255)
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

// -----------------------------------------------------------------------------
// Reviews Models
// -----------------------------------------------------------------------------

// Student reviews Publisher
model CompanyReview {
  id          Int          @id @default(autoincrement())
  publisherId Int          @map("publisher_id")
  studentId   Int          @map("student_id")
  jobId       Int?         @map("job_id")
  rating      Int
  reviewText  String       @map("review_text") @db.Text
  isAnonymous Boolean      @default(false) @map("is_anonymous")
  status      ReviewStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  publisher User @relation("PublisherCompanyReviews", fields: [publisherId], references: [id], onDelete: Cascade)
  student   User @relation("StudentCompanyReviews", fields: [studentId], references: [id], onDelete: Cascade)
  job       Job? @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@unique([publisherId, studentId, jobId], name: "unique_company_review")
  @@index([publisherId])
  @@index([studentId])
  @@index([rating])
  @@map("company_reviews")
}

// Publisher reviews Student
model StudentReview {
  id          Int          @id @default(autoincrement())
  publisherId Int          @map("publisher_id")
  studentId   Int          @map("student_id")
  jobId       Int?         @map("job_id")
  rating      Int
  reviewText  String       @map("review_text") @db.Text
  status      ReviewStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  publisher User @relation("PublisherStudentReviews", fields: [publisherId], references: [id], onDelete: Cascade)
  student   User @relation("StudentReviewsReceived", fields: [studentId], references: [id], onDelete: Cascade)
  job       Job? @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@unique([publisherId, studentId, jobId], name: "unique_student_review")
  @@index([studentId])
  @@index([publisherId])
  @@index([rating])
  @@map("student_reviews")
}

// Generic/legacy Review model
model Review {
  id         Int      @id @default(autoincrement())
  reviewerId Int      @map("reviewer_id")
  revieweeId Int      @map("reviewee_id")
  rating     Int
  comment    String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  reviewer User @relation("ReviewerReviews", fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewee User @relation("RevieweeReviews", fields: [revieweeId], references: [id], onDelete: Cascade)

  @@index([revieweeId])
  @@index([reviewerId])
  @@map("reviews")
}

// -----------------------------------------------------------------------------
// Business & Operational Models
// -----------------------------------------------------------------------------

model Wishlist {
  id        Int      @id @default(autoincrement())
  studentId Int      @map("student_id")
  jobId     Int      @map("job_id")
  createdAt DateTime @default(now()) @map("created_at")

  student User @relation("StudentWishlist", fields: [studentId], references: [id], onDelete: Cascade)
  job     Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([studentId, jobId], name: "unique_student_wishlist")
  @@index([studentId])
  @@map("wishlist")
}

model PublisherImage {
  id          Int      @id @default(autoincrement())
  publisherId Int      @map("publisher_id")
  imageUrl    String   @map("image_url") @db.Text
  uploadedAt  DateTime @default(now()) @map("uploaded_at")

  publisher User @relation("PublisherImages", fields: [publisherId], references: [id], onDelete: Cascade)

  @@index([publisherId])
  @@map("publisher_images")
}

model Payment {
  id             Int                 @id @default(autoincrement())
  publisherId    Int?                @map("publisher_id")
  studentId      Int?                @map("student_id")
  jobId          Int?                @map("job_id")
  amount         Decimal             @db.Decimal(10, 2)
  currency       String              @default("USD") @db.VarChar(10)
  paymentMethod  String              @map("payment_method") @db.VarChar(50)
  paymentGateway String?             @default("stripe") @map("payment_gateway") @db.VarChar(50)
  transactionId  String?             @map("transaction_id") @db.VarChar(255)
  status         PaymentRecordStatus @default(PENDING)
  paymentDate    DateTime?           @map("payment_date")
  description    String?             @db.Text
  metadata       Json?
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  publisher User? @relation("PublisherPayments", fields: [publisherId], references: [id], onDelete: SetNull)
  student   User? @relation("StudentPayments", fields: [studentId], references: [id], onDelete: SetNull)
  job       Job?  @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([publisherId])
  @@index([studentId])
  @@index([jobId])
  @@index([transactionId])
  @@map("payments")
}

model Report {
  id             Int          @id @default(autoincrement())
  type           ReportType   @default(USER)
  reporterId     Int          @map("reporter_id")
  reportedUserId Int?         @map("reported_user_id")
  conversationId Int?         @map("conversation_id")
  reason         String       @db.Text
  status         ReportStatus @default(PENDING)
  createdAt      DateTime     @default(now()) @map("created_at")

  reporter     User          @relation("ReporterReports", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser User?         @relation("ReportedUserReports", fields: [reportedUserId], references: [id], onDelete: SetNull)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([reporterId])
  @@index([reportedUserId])
  @@index([status])
  @@map("reports")
}

model Skill {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("skills")
}

model SiteSetting {
  id           Int      @id @default(autoincrement())
  settingKey   String   @unique @map("setting_key") @db.VarChar(255)
  settingValue String   @map("setting_value") @db.Text
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}

