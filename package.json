{
  "name": "uniwiz-parttime",
  "version": "1.0.0",
  "private": true,
  "description": "UniWiz - University Part-Time Job Portal",
  "scripts": {
    "build": "prisma generate --schema=./prisma/schema.prisma",
    "prisma:generate": "prisma generate --schema=./prisma/schema.prisma",
    "prisma:push": "prisma db push",
    "prisma:seed": "node prisma/seed.js",
    "prisma:studio": "prisma studio",
    "prisma:migrate": "prisma migrate dev",
    "start": "node socket-server.js",
    "start:backend": "php -S 127.0.0.1:80 -t uniwiz-backend",
    "start:socket": "node socket-server.js",
    "start:frontend": "cd uniwiz-frontend && npm start",
    "start:project": "start-project.bat",
    "build:frontend": "cd uniwiz-frontend && npm run build"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.4.0",
    "prisma": "^6.4.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "socket.io": "^4.8.4"
  }
}
