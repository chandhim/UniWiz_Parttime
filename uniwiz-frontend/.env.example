# =============================================================================
# UniWiz Frontend - Environment Configuration Template
# Copy this file to .env and adjust values if needed
# =============================================================================

# Backend API URL (points to PHP backend API or Node backend)
# Examples:
# - Local Apache VirtualHost: http://uniwiz-backend.test/api
# - Local XAMPP/Laragon subfolder: http://localhost/uniwiz-backend/api
# - Local PHP built-in server: http://localhost:8000/api
REACT_APP_API_BASE_URL=http://uniwiz-backend.test/api

# Application Info
REACT_APP_NAME="UniWiz - University Part-Time Job Portal"
REACT_APP_ENV=development
